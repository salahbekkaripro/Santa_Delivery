BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Incident solver tuning thresholds
# Boost solve budget if incident_count >= NOEL_INCIDENT_TUNING_MIN_INCIDENTS
# or mission num_clients >= NOEL_INCIDENT_TUNING_MIN_CLIENTS
NOEL_INCIDENT_TUNING_MIN_INCIDENTS=2
NOEL_INCIDENT_TUNING_MIN_CLIENTS=20

# ADEME Impact CO2 API (gratuite, clé optionnelle)
NOEL_ADEME_CO2_API_URL=https://impactco2.fr/api/v1/transport
NOEL_ADEME_CO2_TIMEOUT_S=8
# Optionnel: la clé peut aussi être fournie via HERE_API_KEY
# NOEL_ADEME_CO2_API_KEY=

# Recherche auto du mix de modes (multimodal)
NOEL_MODE_MIX_SEARCH_ENABLED=1
NOEL_MODE_MIX_SEARCH_MAX_CANDIDATES=8

# Contrainte "une nuit" pour le solveur
# - active une borne temporelle globale (night_horizon_s)
# - et pousse le solveur à servir le maximum de colis via la pénalité de drop
NOEL_ONE_NIGHT_ENABLED=1
NOEL_ONE_NIGHT_DURATION_S=28800
NOEL_ONE_NIGHT_PRIORITIZE_SERVED=1
